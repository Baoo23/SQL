select e.DEPARTMENT_ID, round(avg(e.salary)) as avg_salary from
hr.employees e where e.DEPARTMENT_ID in (select d.DEPARTMENT_ID from 
hr.departments d)
group by e.department_id
order by e.department_id desc; 


select e.DEPARTMENT_ID, round(avg(e.salary)) as avg_salary from
hr.employees e join hr.departments d 
on e.department_id = d.department_id
group by e.department_id
order by e.department_id desc; 

--1) თანამშრომლები რომელთა ხელფასებიც მეტია
--მათი დეპარტემანტების საშუალო ხელფასებზე: (2 ქულა)


select * from hr.employees e where 
e.salary > 
(select avg(ee.salary) from hr.employees ee
where ee.department_id = e.department_id);


select e.employee_id , e.salary, a.department_id, a.avg_salary
from hr.employees e
JOIN (select a.department_id , round(avg(a.salary)) as avg_salary from hr.employees a
group by a.department_id) a
on e.department_id = a.department_id
where  e.salary > a.avg_salary;


with dept_avg AS (
    select department_id,
           avg(salary) AS avg_salary
    from hr.employees
    group by department_id
)
select e.employee_id,
       e.first_name,
       e.last_name,
       e.salary,
       e.department_id,
       d.avg_salary
from hr.employees e
join dept_avg d
  on e.department_id = d.department_id
where e.salary > d.avg_salary;



