/*1. მოგვაქვს შემდეგი მონაცემები : 
თანამშრომლის სახელი,გვარი, პოზიცია, ხელფასი, დეპარტმენტ აიდი, ქალაქი,
მენეჯერის სახელი,გვარი, პოზიცია
მის დეპარტამენტში არსებული თანამშრომლების რაოდენობა
მის მენეჯერის დაქვემდებარებაში მყოფი თანამშრომლების საშუალო ხელფასი.
თანამშრომელბის ლოკაცია არის განსაზღვრული , პოზიცია.
თანამშრომლის ხელფასი ჯდება პოზიციაზე განსაზღვრულ რეინჯში, დიაპაზონში და მათი სტაჟი ნაკლებია 15 წელზე , ვალაკგებთ ხელფასით;
*/

Select e.employee_id,
       e.manager_id,
       e.first_name,
       e.last_name,
       e.job_id,
       e.salary,
       e.department_id,
       l.city,
       (select e1.first_name || ' ' || e1.last_name
          from employees e1
         where e.manager_id = e1.employee_id) as Manager,
       (select e1.job_id
          from employees e1
         where e.manager_id = e1.employee_id) as Manager,
       (select count(*)
          from employees e1
         where e.department_id = e1.department_id) as number_of_people,
       (select avg(e1.salary)
          from employees e1
         where e1.manager_id = e.manager_id) as Manager
  from employees e
  join departments d
    on e.department_id = d.department_id
  join locations l
    on d.location_id = l.location_id
  join jobs j
    on e.job_id = j.job_id
 where e.salary between j.min_salary and j.max_salary
   and months_between(sysdate, e.hire_date) / 12 < 15
 order by e.salary;

/*თანამშრომლების ცხრილიდან წამოიღეთ  ჩანაწერები რომლებიც ასრულებენ შემდეგ პირობებს:
გვარის სიგრძე არის კენტი  რიცხვი, 
 სახელში ან გვარში ერთად გვხვდება მინიმუმ 1 'e' სიმბოლო.მნიშვნელობა არ აქვს upper da lower-ს.
გამოიტანეთ შემდეგ ი ველები:
თანამშრომლის აიდი, სახელი გვარი,
თითოეულ თანამშრომელს 5 წელიწადში ერთხელ აქვს ხელფასის გადახედვა . გადახედვა ხდება იმავე თვის იმავე რიცხვში რომელშიც მოხდა დაქირავება. გამოთვალეთ შემდეგი გადახედვის თარიღი*/

Select e.employee_ID,
       e.first_name || ' ' || e.last_name,
       e.hire_date,
       ADD_MONTHS(e.hire_date,
                  5 * 12 *
                  (TRUNC(MONTHS_BETWEEN(SYSDATE, e.hire_date) / (5 * 12)) + 1)) as next_revision_date
  from employees e
 where mod(length(e.last_name), 2) <> 0
   and lower(e.first_name || e.last_name) like '%e%';

/*თანამშრომლების ცხრილიდან წამოვიღოთ ისეთი სახელი,გვარი,პოზიცია, ხელფასი და დეპარტამენტი რომლებიც აკმაყოფილებს შემდეგ პირობებს:
 გვარი შეიცავს 2 ცალ 'a' ს ან 'o'-ს ან 'p'-ს
 დაქირავებული არ უნდა იყოს ბოლო 5 წლის მანძილზე
 department_name არ უნდა იყოს Executive,Finance
ასევე დაამატეთ ველი თუ წლიური ხელფასი დამრგვალებული ათეულებამდე არის 1000ზე ნაკლები მიუთითეთ Low, თუ 1000 დან 5000 მდე avg, და თუ მეტი 5000 ზე high.*/

Select e.first_name,
       e.last_name,
       e.job_id,
       e.salary,
       d.department_name,
       Case
         when e.salary * 12 < 1000 then
          'Low'
         when e.salary * 12 < 5000 then
          'avg'
         when e.salary * 12 > 5000 then
          'high'
         else
          'na'
       end as salary_range
  from employees e
  join departments d
    on e.department_id = d.department_id
 where (lower(e.last_name) like '%a%a%' or lower(e.last_name) like '%o%o%' or
       lower(e.last_name) like '%p%p%')
   and months_between(sysdate, e.hire_date) > 60
   and d.department_name not in ('Executive', 'Finance');

/*დაასელექთეთ ყველა თანამშრომელი, რომელთა ხელფასიც მეტია იმ დეპარტამენტის საშუალო
 ხელფასზე რომელშიც მუშაობს ყველზე დაბალხელფასიანი თანამშრომელი.გარდა ამისა,
  არ უნდა მუშაობდნენ არც დეპარტამენტ 'Finance'-ში და არც 'Marketing'-ში და მათი დეპარტამენტისთვის 
  "STATE_PROVINCE" არ უნდა იყოს უცნობი,დაბეჭდეთ ველები: გვარი და პოზიცია(job_id) ერთ ველად მათ შორის '_' 
  სიმბოლოთი;დასაქმების თარიღი შემდეგი სახით: მაგ.'11-OCTOBER-2001';
სამუშაოს დაწყებიდან გასული კვარტლების რაოდენობა (მთელ რიცხვებამდე დამრგვალებული მათემატიკური წესით);
მიმდინარე პოზიციაზე დანიშვნის წელს გამომუშავებული ჯამური ხელფასი
 (employees-ში წერია მიმდინარე პოზიცია და ამ პოზიციაზე მუშაობის დაწყებიდან არსებული ხელფასი უცვლელად);
*/

select e.last_name || '_' || e.job_id field1,
       replace(to_char(e.hire_date, 'DD-MONTH-YYYY'), ' ', '') field2,
       round(months_between(sysdate, e.hire_date) / 3) field3,
       (12 - to_Number(to_char(e.hire_date, 'MM')) + 1) * e.salary field4
  from employees e, departments d, locations l
 where e.department_id = d.department_id
   and d.location_id = l.location_id
   and e.salary >
       (select avg(ee.salary)
          from employees ee
         where ee.department_id =
               (select eee.department_id
                  from employees eee
                 where eee.salary =
                       (select min(eeee.salary) from employees eeee)))
   and d.department_name not in ('Finance', 'Marketing')
   and l.state_province is not null;

-- რეგიონებისთვის დათვალეთ წლების მიხედვით დაქირავებული თანამშრომების რაოდენობა
select c.region_id, to_char(e.hire_date, 'YYYY'), count(1)
  from employees e, departments d, locations l, countries c
 where e.department_id = d.department_id
   and d.location_id = l.location_id
   and c.country_id = l.country_id
 group by c.region_id, to_char(e.hire_date, 'YYYY')
 order by c.region_id, to_char(e.hire_date, 'YYYY');
minus
select x.year, x.region_id, count(1)
  from (select to_char(e.hire_date, 'YYYY') year,
               (select (select (select c.region_id
                                  from countries c
                                 where c.country_id = l.country_id)
                          from locations l
                         where l.location_id = d.location_id)
                  from departments d
                 where d.department_id = e.department_id) as region_id
          from employees e) x
 where x.region_id is not null
 group by x.region_id, x.year
 order by x.region_id, x.year;

